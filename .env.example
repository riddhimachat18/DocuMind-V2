VITE_FIREBASE_MESSAGING_SENDER_ID=1051747171351
VITE_FIREBASE_APP_ID=1:1051747171351:web:19f630958b182b878cb052

# Cloud Run Service URLs
VITE_CLASSIFY_SNIPPET_URL=https://classifysnippet-YOUR_HASH.run.app
VITE_GENERATE_BRD_URL=https://generatebrd-YOUR_HASH.run.app
VITE_DETECT_CONFLICTS_URL=https://detectconflicts-YOUR_HASH.run.app
VITE_RESOLVE_CONFLICT_URL=https://onconflictresolved-YOUR_HASH.run.app
