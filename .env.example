# Google Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Gmail OAuth (client-side — for the OAuth popup)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Slack OAuth (client-side — for the OAuth popup)
VITE_SLACK_CLIENT_ID=your_slack_client_id_here

# Base URL of your deployed Firebase Functions (used to build the Slack redirect URI)
# e.g. https://us-central1-documind-6c687.cloudfunctions.net
VITE_FUNCTIONS_BASE_URL=https://us-central1-documind-6c687.cloudfunctions.net

# Firebase Secret Manager keys (set via: firebase functions:secrets:set KEY_NAME)
# GEMINI_API_KEY=...
# GOOGLE_CLIENT_ID=...
# GOOGLE_CLIENT_SECRET=...
# SLACK_CLIENT_ID=...       ← replaces SLACK_BOT_TOKEN
# SLACK_CLIENT_SECRET=...
